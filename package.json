{
  "name": "commonground-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "seed:pinecone": "node scripts/seed-pinecone.mjs",
    "seed:neo4j": "node scripts/seed-neo4j.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --import tsx scripts/run-evals.ts",
    "eval:live": "node --import tsx scripts/run-evals.ts --live",
    "eval:retrieval": "node --import tsx scripts/run-retrieval-evals.ts",
    "eval:retrieval:live": "node --import tsx scripts/run-retrieval-evals.ts --live",
    "eval:week4": "node --import tsx scripts/run-week4-evals.ts",
    "eval:week4:dataset": "node --import tsx scripts/sync-week4-dataset.ts",
    "eval:week4:dataset:generate": "node --import tsx scripts/generate-week4-dataset.ts",
    "eval:week4:dataset:sync": "node --import tsx scripts/sync-week4-dataset.ts --langsmith",
    "eval:week4:live": "node --import tsx scripts/run-week4-evals.ts --live",
    "eval:week4:langsmith": "node --import tsx scripts/run-week4-evals.ts --live --langsmith",
    "eval:week4:direct": "node --import tsx scripts/run-week4-evals.ts --live --direct --langsmith",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm eval && pnpm eval:retrieval && pnpm eval:week4 && pnpm eval:week4:dataset && pnpm build",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint app lib db tests scripts components/turnstile-gate.tsx components/practice-lab.tsx components/policy-monitor.tsx components/knowledge-map.tsx components/trust-shell.tsx components/system-status.tsx",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "langsmith": "^0.7.17",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
