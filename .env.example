# Required: model inference, embeddings, and reranking
FIREWORKS_API_KEY=
FIREWORKS_CHAT_MODEL=accounts/fireworks/models/qwen3p7-plus
# Optional role router; when blank, practice agents use FIREWORKS_CHAT_MODEL
FIREWORKS_FAST_MODEL=
FIREWORKS_EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b
FIREWORKS_RERANK_MODEL=accounts/fireworks/models/qwen3-reranker-8b

# Cross-provider safety panel
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Required: vector retrieval
PINECONE_API_KEY=
PINECONE_INDEX_NAME=commonground-rj
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=commonground-rj-v1

# GraphRAG relationship expansion through the Neo4j HTTPS Query API
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required to activate the live API
LIVE_AI_ENABLED=true
# Public deployment remains a training demonstration until an agency-owned
# identity, security, legal, records, accessibility, and data review is complete.
RELEASE_VERSION=pilot-v6

# Optional until configured; set both keys and enable enforcement together
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCED=false
RATE_LIMIT_SALT=
APPROVAL_SIGNING_SECRET=

# AI voice transcription and bilingual read-aloud
DEEPGRAM_API_KEY=

# Optional: production observability and evaluations
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=commonground-ai-production
LANGSMITH_WORKSPACE_ID=
EVAL_RUNNER_SECRET=

# Optional: allowlisted public-source freshness research
YOU_API_KEY=
